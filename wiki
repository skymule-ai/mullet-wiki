#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
args=(serve -a 127.0.0.1:8088 "$@")
if command -v uv >/dev/null 2>&1; then
  exec uv run --with-requirements requirements.txt mkdocs "${args[@]}"
fi
if python3 -m venv .venv; then
  .venv/bin/pip install -q -r requirements.txt
  exec .venv/bin/mkdocs "${args[@]}"
fi
echo "Need uv (https://docs.astral.sh/uv/) or python3-venv" >&2
exit 1
